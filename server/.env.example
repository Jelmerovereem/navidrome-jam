# Server Configuration
PORT=3001

# CORS Configuration
CLIENT_URL=http://localhost:3000

# Navidrome Instance
NAVIDROME_URL=http://localhost:4533

# Admin credentials for invite-based registration
NAVIDROME_ADMIN_USER=admin
NAVIDROME_ADMIN_PASS=
# Comma-separated single-use invite codes
INVITE_CODES=FRIEND1,FRIEND2,FAMILY3

# Persistent data directory (invite codes, waitlist, room snapshots)
# DATA_DIR=./data

# Public base URL of this server (used for links in Telegram notifications)
# PUBLIC_SERVER_URL=https://jam-api.example.com

# Invite emails (Resend)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Waitlist notifications (Telegram)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# User uploads via SFTP to the Navidrome music folder (disabled if unset)
# SFTP_HOST=
# SFTP_PORT=22
# SFTP_USER=
# SFTP_PASS=
# SFTP_MUSIC_PATH=/music

# Optional groups API for room community tags (disabled if unset)
# COMMUNITIES_API_URL=
